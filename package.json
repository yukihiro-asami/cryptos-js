{
  "name": "cryptos-js",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Handwritten JavaScript cryptographic reference implementations by Yukihiro Asami",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check:imports": "node scripts/check-imports.mjs",
    "test:reference": "node scripts/run-reference-tests.mjs",
    "test:interop": "node --test tests/interop.test.mjs",
    "test": "npm run check:imports && npm run test:reference && npm run test:regression && npm run test:interop",
    "test:regression": "node --test tests/point-decoding.test.mjs tests/signature-scalar.test.mjs tests/ed25519-arithmetic.test.mjs",
    "examples": "node examples/node.mjs",
    "examples:browser": "node scripts/serve-examples.mjs"
  },
  "author": "Yukihiro Asami",
  "repository": {
    "type": "git",
    "url": "https://github.com/yukihiro-asami/cryptos-js.git"
  }
}
